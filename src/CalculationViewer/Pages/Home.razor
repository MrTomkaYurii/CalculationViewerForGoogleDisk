@page "/"
@implements IDisposable
@inject IFolderCatalog Catalog

<PageTitle>Розрахунки</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="cv-page">
    <section class="cv-intro">
        <h1>Розрахунки</h1>
        <p class="cv-lead">Нижче опис кожної папки: що в ній лежить і як це пораховано. Натисніть «Відкрити папку», щоб перейти до файлів. Вхід не потрібен.</p>
    </section>

    <div class="cv-toolbar">
        <MudTextField @bind-Value="_query" Class="cv-search" Placeholder="Знайти за назвою або описом" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Immediate="true" Clearable="true"
                      aria-label="Знайти за назвою або описом" />
        @if (_all is not null)
        {
            <span class="cv-mono cv-muted">@Ua.Folders(Filtered.Count())</span>
        }
    </div>

    @if (_loading)
    {
        <LoadingNote Text="Завантажуємо список папок…" />
        <div class="cv-legend" aria-busy="true">
            @for (var i = 0; i < 3; i++) { <div class="cv-skel" style="height:260px"></div> }
        </div>
    }
    else if (_error is not null)
    {
        <StateBox IsError="true" Icon="@Icons.Material.Outlined.CloudOff" Title="Не вдалося завантажити список папок" Text="@_error">
            <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Спробувати ще раз</MudButton></Actions>
        </StateBox>
    }
    else if (_all is { Count: 0 })
    {
        <StateBox Icon="@Icons.Material.Outlined.FolderOff" Title="Папок поки немає" Text="Адміністратор ще не підключив жодної папки." />
    }
    else if (!Filtered.Any())
    {
        <StateBox Icon="@Icons.Material.Outlined.SearchOff" Title="Нічого не знайдено" Text="@($"За запитом «{_query}» немає папок чи описів. Спробуйте коротше слово.")" />
    }
    else
    {
        <div class="cv-legend">
            @foreach (var f in Filtered)
            {
                <article class="cv-legend__item" @key="f.Id" aria-label="@f.Title">
                    <header class="cv-legend__head">
                        <span class="cv-legend__icon"><MudIcon Icon="@Icons.Material.Outlined.Folder" /></span>
                        <div class="cv-legend__titles">
                            <h2 class="cv-legend__title">@f.Title</h2>
                            @if (f.UpdatedUtc is { } d) { <span class="cv-mono cv-muted">оновлено @Ua.Date(d)</span> }
                        </div>
                        <MudButton Href="@($"folder/{f.Id}")" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Class="cv-legend__open">Відкрити папку</MudButton>
                    </header>
                    @if (!string.IsNullOrWhiteSpace(f.Description))
                    {
                        <div class="cv-legend__body"><MarkdownView Source="@f.Description" /></div>
                    }
                </article>
            }
        </div>
    }
</MudContainer>

@code {
    IReadOnlyList<CatalogFolder>? _all;
    string _query = "";
    bool _loading = true;
    string? _error;
    CancellationTokenSource? _cts;

    // Пошук іде і за назвою, і за текстом опису: на головній користувач читає саме опис.
    IEnumerable<CatalogFolder> Filtered => (_all ?? [])
        .Where(f => string.IsNullOrWhiteSpace(_query)
                    || f.Title.Contains(_query.Trim(), StringComparison.CurrentCultureIgnoreCase)
                    || f.Description.Contains(_query.Trim(), StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        Catalog.Changed += OnChanged;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _loading = true;
        _error = null;
        try { _all = await Catalog.GetAllAsync(_cts.Token); }
        catch (DriveAccessException e) { _error = e.Message; }
        catch (OperationCanceledException) { return; }
        _loading = false;
    }

    void OnChanged() => _ = InvokeAsync(LoadAsync);

    public void Dispose()
    {
        Catalog.Changed -= OnChanged;
        _cts?.Cancel();
    }
}
