@page "/folder/{*Path}"
@implements IDisposable
@inject IDriveBrowser Drive
@inject IFolderCatalog Catalog
@inject ICollectionStore Collections
@inject BookmarkActions Bookmarks
@inject UiPrefs Prefs
@inject NavigationManager Nav

<PageTitle>@(Title ?? "Папка") · Розрахунки</PageTitle>

@if (_path.Count > 0)
{
    <MudDrawer @bind-Open="_treeOpen" Anchor="Anchor.Start" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Always" Elevation="0" Width="248px" Class="cv-tree-drawer">
        <div class="cv-tree__head">
            <a class="cv-tree__back" href=""><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />Усі папки</a>
            <div class="cv-tree__title">@(_root?.Title ?? _path[0].Name)</div>
        </div>
        <div class="cv-tree__body" aria-label="Дерево папок">
            <FolderTree Path="_path" CurrentId="@FolderId" />
        </div>
    </MudDrawer>
}

<MudContainer MaxWidth="MaxWidth.Large" Class="cv-page cv-page--folder">
    @if (_path.Count > 0) { <DeepCrumbs Path="_path" /> }

    <div class="cv-head">
        <div class="cv-head__main">
            <MudIconButton Icon="@Icons.Material.Outlined.AccountTree" Class="cv-treebtn" OnClick="() => _treeOpen = !_treeOpen" aria-label="Дерево папок" />
            <div class="cv-head__text">
                @if (Title is not null) { <h1 class="cv-title">@Title</h1> }
                else { <div class="cv-skel" style="height:30px;width:min(420px,70vw)"></div> }
                @if (StatsLine is { Length: > 0 } stats && !_loading && _error is null) { <span class="cv-head__stats" role="status">@stats</span> }
            </div>
        </div>
        @if (Title is not null && _listing is not null)
        {
            <StarButton IsOn="@Collections.IsBookmarked(BookmarkKind.Folder, FolderId)" OnClick="() => Bookmarks.AddFolderAsync(Path, Title)" />
        }
    </div>

    @if (_loading)
    {
        <LoadingNote Text="Завантажуємо вміст папки…" />
        <div class="cv-dirs" aria-busy="true">
            @for (var i = 0; i < 6; i++) { <div class="cv-skel" style="height:52px"></div> }
        </div>
        <div class="cv-files" style="margin-top:28px">
            @for (var i = 0; i < 8; i++) { <div class="cv-skel" style="aspect-ratio:4/3.3"></div> }
        </div>
    }
    else if (_error is not null)
    {
        @if (_notConnected)
        {
            <StateBox Icon="@Icons.Material.Outlined.CloudQueue" Title="Файли ще не підключено" Text="@_error">
                <Actions><MudButton Variant="Variant.Outlined" Href="">До списку папок</MudButton></Actions>
            </StateBox>
        }
        else
        {
            <StateBox IsError="true" Icon="@Icons.Material.Outlined.LockOpen" Title="Не вдалося відкрити папку" Text="@_error">
                <Actions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => LoadAsync()">Спробувати ще раз</MudButton>
                    <MudButton Variant="Variant.Outlined" Href="">До списку папок</MudButton>
                </Actions>
            </StateBox>
        }
    }
    else if (_listing is not null)
    {
        var imgs = _sortedFiles.Count(f => f.IsImage);
        var docs = _sortedFiles.Count - imgs;
        var hasMain = _listing.Folders.Count + _sortedFiles.Count > 0;

        @if (!hasMain && _technical.Count == 0)
        {
            <StateBox Icon="@Icons.Material.Outlined.FolderOpen" Title="У цій папці порожньо" Text="Тут немає ні підпапок, ні файлів.">
                <Actions>
                    @if (_path.Count > 1)
                    {
                        <MudButton Variant="Variant.Outlined" Href="@ParentHref" StartIcon="@Icons.Material.Filled.ArrowUpward">На рівень вище</MudButton>
                    }
                </Actions>
            </StateBox>
        }

        @if (hasMain)
        {
            <div class="cv-controls">
                <MudTextField @bind-Value="_query" Class="cv-search" Placeholder="Пошук у цій папці" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Immediate="true" Clearable="true"
                              aria-label="Пошук у цій папці" TextChanged="OnQueryChanged" />
                @if (_sortedFiles.Count > 0)
                {
                    @if (imgs > 0 && docs > 0)
                    {
                        <div class="cv-seg cv-seg--filters" role="group" aria-label="Тип файлів">
                            <button type="button" aria-pressed="@(_cat == "all" ? "true" : "false")" @onclick='() => SetCat("all")'>Усі <span class="cv-seg__n">@_sortedFiles.Count</span></button>
                            <button type="button" aria-pressed="@(_cat == "img" ? "true" : "false")" @onclick='() => SetCat("img")'>Зображення <span class="cv-seg__n">@imgs</span></button>
                            <button type="button" aria-pressed="@(_cat == "doc" ? "true" : "false")" @onclick='() => SetCat("doc")'>Документи <span class="cv-seg__n">@docs</span></button>
                        </div>
                    }
                    <span class="cv-controls__spacer"></span>
                    <div class="cv-seg cv-seg--icons" role="group" aria-label="Вигляд">
                        <button type="button" aria-pressed="@(Prefs.View == ViewMode.Grid ? "true" : "false")" @onclick="() => Prefs.View = ViewMode.Grid" aria-label="Плитка"><MudIcon Icon="@Icons.Material.Outlined.GridView" Size="Size.Small" /></button>
                        <button type="button" aria-pressed="@(Prefs.View == ViewMode.List ? "true" : "false")" @onclick="() => Prefs.View = ViewMode.List" aria-label="Список"><MudIcon Icon="@Icons.Material.Outlined.ViewList" Size="Size.Small" /></button>
                    </div>
                }
            </div>

            var dirs = VisibleFolders;
            var files = VisibleFiles;

            @if (dirs.Count == 0 && files.Count == 0)
            {
                <StateBox Icon="@Icons.Material.Outlined.SearchOff" Title="Нічого не знайдено" Text="@($"У цій папці немає елементів за запитом «{_query}».")">
                    <Actions><MudButton Variant="Variant.Outlined" OnClick="ResetFilters">Скинути пошук і фільтр</MudButton></Actions>
                </StateBox>
            }

            @if (dirs.Count > 0)
            {
                <section class="cv-section" aria-label="Підпапки">
                    <h2 class="cv-section__title cv-section__title--tools">
                        <span>Підпапки <span class="cv-mono">@dirs.Count</span></span>
                        <div class="cv-seg cv-seg--icons" role="group" aria-label="Вигляд підпапок">
                            <button type="button" aria-pressed="@(Prefs.FolderView == ViewMode.Grid ? "true" : "false")" @onclick="() => Prefs.FolderView = ViewMode.Grid" aria-label="Підпапки плиткою" title="Плитка"><MudIcon Icon="@Icons.Material.Outlined.GridView" Size="Size.Small" /></button>
                            <button type="button" aria-pressed="@(Prefs.FolderView == ViewMode.List ? "true" : "false")" @onclick="() => Prefs.FolderView = ViewMode.List" aria-label="Підпапки списком" title="Список"><MudIcon Icon="@Icons.Material.Outlined.ViewList" Size="Size.Small" /></button>
                        </div>
                    </h2>
                    @if (Prefs.FolderView == ViewMode.Grid)
                    {
                        <div class="cv-dirs">
                            @foreach (var d in dirs)
                            {
                                <div class="cv-dir" @key="d.Id">
                                    <a class="cv-dir__link" href="folder/@Path/@d.Id" title="@d.Name">
                                        <span class="cv-dir__icon"><MudIcon Icon="@Icons.Material.Filled.Folder" /></span>
                                        <span class="cv-dir__name">@d.Name</span>
                                    </a>
                                    <StarButton IsOn="@Collections.IsBookmarked(BookmarkKind.Folder, d.Id)" OnClick="() => AddSubfolderAsync(d)" Size="Size.Small" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="cv-dlist">
                            @foreach (var d in dirs)
                            {
                                <div class="cv-drow" @key="d.Id">
                                    <a class="cv-drow__link" href="folder/@Path/@d.Id" title="@d.Name">
                                        <span class="cv-dir__icon"><MudIcon Icon="@Icons.Material.Filled.Folder" /></span>
                                        <span class="cv-drow__name">@d.Name</span>
                                        @if (d.ModifiedUtc is { } modified) { <span class="cv-drow__date cv-mono">@Ua.Date(modified)</span> }
                                    </a>
                                    <StarButton IsOn="@Collections.IsBookmarked(BookmarkKind.Folder, d.Id)" OnClick="() => AddSubfolderAsync(d)" Size="Size.Small" />
                                </div>
                            }
                        </div>
                    }
                </section>
            }

            @if (files.Count > 0)
            {
                <section class="cv-section" aria-label="Файли">
                    <h2 class="cv-section__title">Файли <span class="cv-mono">@files.Count</span></h2>
                    @if (Prefs.View == ViewMode.Grid)
                    {
                        <div class="cv-files">
                            @foreach (var f in files.Take(_shown))
                            {
                                <FileTile @key="f.Id" File="f" Href="@FileHref(f)" Bookmarked="@Collections.IsBookmarked(BookmarkKind.File, f.Id)" OnStar="() => Bookmarks.AddFileAsync(f, Path)" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="cv-flist">
                            @foreach (var f in files.Take(_shown))
                            {
                                <FileRow @key="f.Id" File="f" Href="@FileHref(f)" Bookmarked="@Collections.IsBookmarked(BookmarkKind.File, f.Id)" OnStar="() => Bookmarks.AddFileAsync(f, Path)" />
                            }
                        </div>
                    }
                    @if (files.Count > _shown)
                    {
                        <div class="cv-more">
                            <MudButton Variant="Variant.Outlined" OnClick="() => _shown += PageSize">Показати ще @Math.Min(PageSize, files.Count - _shown) з @Ua.Num(files.Count - _shown)</MudButton>
                        </div>
                    }
                </section>
            }
        }

        @if (_technical.Count > 0)
        {
            <section class="cv-tech" aria-label="Службові файли">
                <button type="button" class="cv-tech__head" @onclick="() => _techOpen = !_techOpen" aria-expanded="@_techOpen.ToString().ToLowerInvariant()">
                    <MudIcon Icon="@Icons.Material.Outlined.Storage" Size="Size.Small" />
                    <span class="cv-tech__title">Службові файли</span>
                    <span class="cv-mono cv-muted">@Ua.Num(_technical.Count)</span>
                    <span class="cv-tech__hint">дані для розрахунків, без перегляду</span>
                    <MudIcon Icon="@(_techOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                </button>
                @if (_techOpen)
                {
                    <ul class="cv-tech__list">
                        @foreach (var f in _technical.Take(_techShown))
                        {
                            <li class="cv-tech__row" @key="f.Id">
                                <FileName Name="@f.Name" />
                                <span class="cv-tech__size">@Ua.Size(f.SizeBytes)</span>
                                <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small" Href="@Drive.GetDownloadUrl(f.Id)" aria-label="@($"Завантажити {f.Name}")" />
                            </li>
                        }
                    </ul>
                    @if (_technical.Count > _techShown)
                    {
                        <div class="cv-more" style="margin:0;padding:10px">
                            <MudButton Variant="Variant.Text" OnClick="() => _techShown += PageSize">Показати ще @Math.Min(PageSize, _technical.Count - _techShown)</MudButton>
                        </div>
                    }
                }
            </section>
        }
    }
</MudContainer>

@if (SelectedFile is not null && _listing is not null)
{
    <FileViewer Files="_sortedFiles" CurrentId="@SelectedFile" FolderPath="@Path" />
}

@code {
    const int PageSize = 60;

    /// <summary>Шлях у адресі: id папок через «/», від підключеної папки до поточної. Path зберігається в адресі, бо Google Drive не віддає батька папки анонімним запитам.</summary>
    [Parameter] public string Path { get; set; } = "";
    [SupplyParameterFromQuery(Name = "file")] public string? SelectedFile { get; set; }

    string[] Chain => Path.Split('/', StringSplitOptions.RemoveEmptyEntries);
    string FolderId => Chain.LastOrDefault() ?? "";
    string ParentHref => "folder/" + string.Join('/', _path.Take(Math.Max(1, _path.Count - 1)).Select(s => s.Id));

    IReadOnlyList<PathSegment> _path = [];
    CatalogFolder? _root;
    DriveListing? _listing;
    /// <summary>Файли, які має сенс дивитися: зображення, PDF, DOCX, текст. Саме вони в плитках, фільтрах і стрічці переглядача.</summary>
    IReadOnlyList<DriveFile> _sortedFiles = [];
    /// <summary>Файли без перегляду (.mat та подібні): дані для розрахунків, окремий згорнутий список.</summary>
    IReadOnlyList<DriveFile> _technical = [];
    IReadOnlyList<DriveFolder> _sortedFolders = [];
    bool _loading = true, _treeOpen, _techOpen, _notConnected;
    string? _error;
    string _query = "", _cat = "all";
    int _shown = PageSize, _techShown = PageSize;
    string? _loadedId;
    CancellationTokenSource? _cts;

    string? Title => _root?.Title is { } t && _root.Id == FolderId ? t : _listing?.Folder.Name ?? _path.LastOrDefault()?.Name;

    /// <summary>Що лежить у папці, одним рядком під назвою: «5 підпапок · 23 зображення». Нулі не показуємо.</summary>
    string StatsLine
    {
        get
        {
            if (_listing is null) return "";
            var imgs = _sortedFiles.Count(f => f.IsImage);
            var parts = new List<string>(4);
            if (_listing.Folders.Count > 0) parts.Add(Ua.Subfolders(_listing.Folders.Count));
            if (imgs > 0) parts.Add(Ua.Images(imgs));
            if (_sortedFiles.Count - imgs > 0) parts.Add(Ua.Documents(_sortedFiles.Count - imgs));
            if (_technical.Count > 0) parts.Add(Ua.Count(_technical.Count, "службовий", "службові", "службових"));
            return string.Join(" · ", parts);
        }
    }

    IReadOnlyList<DriveFolder> VisibleFolders => _cat != "all" ? [] : _sortedFolders.Where(Matches).ToList();

    IReadOnlyList<DriveFile> VisibleFiles => _sortedFiles
        .Where(f => _cat == "all" || (_cat == "img" ? f.IsImage : !f.IsImage))
        .Where(f => Matches(f.Name))
        .ToList();

    bool Matches(DriveFolder f) => Matches(f.Name);
    bool Matches(string name) => string.IsNullOrWhiteSpace(_query) || name.Contains(_query.Trim(), StringComparison.CurrentCultureIgnoreCase);

    protected override void OnInitialized() => Collections.Changed += OnStoreChanged;

    protected override void OnParametersSet()
    {
        if (_loadedId == Path) return;
        _loadedId = Path;
        _query = "";
        _cat = "all";
        _shown = PageSize;
        _techShown = PageSize;
        _ = LoadAsync();
    }

    async Task LoadAsync()
    {
        _cts?.Cancel();
        var cts = _cts = new CancellationTokenSource();
        _loading = true;
        _error = null;
        _notConnected = false;
        _listing = null;
        StateHasChanged();
        try
        {
            var chain = Chain;
            var path = chain.Length == 0 ? [] : await Drive.GetPathAsync(chain, cts.Token);
            if (path.Count == 0)
            {
                // Підключена папка є в каталозі, але джерело файлів її не знає (Google Drive ще не підключений).
                // Лишаємо на сторінці назву й опис, а замість файлів пояснюємо, чому їх немає.
                _root = chain.Length == 1 ? await Catalog.FindAsync(chain[0], cts.Token) : null;
                if (_root is null) throw new DriveAccessException("Папку не знайдено.");
                _path = [new PathSegment(_root.Id, _root.Title)];
                _notConnected = true;
                throw new DriveAccessException("Перегляд файлів із Google Drive буде підключено найближчим часом.");
            }
            _path = path;
            _root = await Catalog.FindAsync(path[0].Id, cts.Token);
            var listing = await Drive.GetListingAsync(FolderId, cts.Token);
            var files = listing.Files.OrderBy(f => f.Name, NaturalComparer.Instance).ToList();
            _sortedFolders = listing.Folders.OrderBy(f => f.Name, NaturalComparer.Instance).ToList();
            _sortedFiles = files.Where(f => f.Kind != FileKind.Other).ToList();
            _technical = files.Where(f => f.Kind == FileKind.Other).ToList();
            // Службові файли розгорнуті лише тоді, коли в папці більше нічого немає.
            _techOpen = _sortedFiles.Count == 0 && _sortedFolders.Count == 0;
            _listing = listing;
        }
        catch (DriveAccessException e) { _error = e.Message; }
        catch (OperationCanceledException) { return; }
        _loading = false;
        StateHasChanged();
    }

    string FileHref(DriveFile f) => $"folder/{Path}?file={Uri.EscapeDataString(f.Id)}";

    Task AddSubfolderAsync(DriveFolder d) => Bookmarks.AddFolderAsync($"{Path}/{d.Id}", d.Name);

    void SetCat(string cat) { _cat = cat; _shown = PageSize; }
    void OnQueryChanged(string q) { _query = q; _shown = PageSize; }
    void ResetFilters() { _query = ""; _cat = "all"; }
    void OnStoreChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Collections.Changed -= OnStoreChanged;
        _cts?.Cancel();
    }
}
